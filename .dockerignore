InferenceNode/model_repository/*.pth
*.pt
*.pth
yolo*.pt

# Runtime DATA directories - provided by bind mounts at runtime, never baked
# into the image. Keeping them out makes the build context code-only (fast builds).
InferenceNode/media/
InferenceNode/model_repository/
InferenceNode/pipelines/
storage/

# Dead scratch files not needed in the image
zeciever.py
kernel.errors.txt

# New compose structure (not needed inside the image)
compose*.yaml
docker-start.sh

# Temporary files
tmp/
temp/
.env
.env.*
!.env.example
secrets/

# Managed runtime data, including the durable event outbox
InferenceNode/data/
