# Copy to .env and fill in real values. Do NOT commit .env.
# The .env file is read by docker-compose to populate ${WEBHOOK_AUTH_TOKEN}.

# ============================================================================
# Deployment selection - configure once, then just:  docker compose up -d
# (or ./docker-start.sh, which validates the selection before starting)
# ============================================================================
# APP_ENV: development | production   (explicit - never auto-detected)
# ACCELERATOR: cpu | gpu              (explicit - validated against the host,
#                                      fails clearly instead of silent fallback)
APP_ENV=production
ACCELERATOR=cpu
# Windows defaults COMPOSE_FILE's separator to ';' - force ':' for portability.
COMPOSE_PATH_SEPARATOR=:
# Pick the combination matching APP_ENV + ACCELERATOR:
#   production  + cpu:  COMPOSE_FILE=compose.yaml:compose.prod.yaml:compose.cpu.yaml
#   production  + gpu:  COMPOSE_FILE=compose.yaml:compose.prod.yaml:compose.gpu.yaml
#   development + cpu:  COMPOSE_FILE=compose.yaml:compose.dev.yaml:compose.cpu.yaml
#   development + gpu:  COMPOSE_FILE=compose.yaml:compose.dev.yaml:compose.gpu.yaml
COMPOSE_FILE=compose.yaml:compose.prod.yaml:compose.cpu.yaml

# PostgreSQL password for ArmyEye's own database (service "db", container VMS-db).
# Containers talk to it at db:5432; dev publishes host port 5433 (5432 is taken
# by FACE_DETECTOR on this host).
ARMEYE_DB_PASSWORD=<strong-db-password>
# Host port for dev psql access (dev override only)
# ARMEYE_DB_PORT=5433
# Web UI port
# NODE_PORT=5555

# ---------------------------------------------------------------------------
# Detection webhook destination (deployment-level SINGLE SOURCE OF TRUTH).
# Every pipeline posts to:   {WEBHOOK_BASE_URL}/webhook/{pipeline_id}
# Only the pipeline_id varies per pipeline - the receiver host is configured
# once, here. The value is used EXACTLY as written (no address rewriting).
#
# FACE nginx is the stable webhook entry point in every deployment; never point
# this at the API port 8000 directly.
#
#   SAME physical server (Docker DNS over the shared 'webhook_integration'
#   network - created by docker-start.sh; FACE nginx carries the alias):
#     FACE dev stack  (nginx.conf, plain :80)      : WEBHOOK_BASE_URL=http://face-webhook
#     FACE prod stack (nginx.prod.conf, 308->HTTPS): WEBHOOK_BASE_URL=https://face-detector.internal
#       - use a name that is IN FACE's certificate SAN (face-detector.internal is; 'face-webhook'
#         is not, and fails hostname verification). FACE's nginx carries both aliases on the
#         shared network. TLS is verified against FACE's internal CA - mount it via
#         FACE_INTERNAL_CA_FILE below; the entrypoint appends it to the public CA bundle so
#         public downloads (Ultralytics weights) keep working. Verification is never disabled.
#
#   DIFFERENT physical servers (private LAN/VLAN/VPN to FACE nginx):
#     internal DNS   : WEBHOOK_BASE_URL=https://face-api.internal
#     private IP     : WEBHOOK_BASE_URL=http://192.168.1.50
#     custom port    : WEBHOOK_BASE_URL=https://face-api.internal:8443
#
#   NEVER (same-server): 127.0.0.1 / localhost (that is the VMS container
#   itself), host.docker.internal, container IPs, or a host-published API port.
#
# Must be scheme://host[:port] only - no path, query, fragment, or credentials.
# If unset, legacy per-destination URLs still work but are DEPRECATED.
WEBHOOK_BASE_URL=http://face-webhook

# Bearer token the webhook sender uses to authenticate to the receiving system.
# Sent as the HTTP header:  Authorization: Bearer <WEBHOOK_AUTH_TOKEN>
# Never placed in the URL, query string, or JSON payload; never logged.
WEBHOOK_AUTH_TOKEN=<strong-secret-token>

# Auth is required by default (fail-closed): if the token is missing the webhook
# does NOT send. Set to false only to intentionally allow unauthenticated webhooks.
WEBHOOK_AUTH_REQUIRED=false

# Alternative to the env var: read the token from a file / Docker secret.
# WEBHOOK_AUTH_TOKEN_FILE=/run/secrets/webhook_auth_token


# ============================================================================
# Authentication (ArmyEye's OWN database - fully self-contained)
# ============================================================================
# ArmyEye owns its users/roles/pipelines/models in its OWN PostgreSQL database.
# It has NO database dependency on FACE_DETECTOR. Point this at ArmyEye's DB.
# (An async +asyncpg suffix is normalized to a sync driver automatically.)
ARMYEYE_DATABASE_URL=postgresql://armeye:<password>@localhost:5432/armeye
# Or read it from a file / Docker secret instead:
# ARMYEYE_DATABASE_URL_FILE=/run/secrets/armeye_database_url

# Initial admin, seeded ONLY when the users table is completely empty (first run).
# The seeded admin must change this password on first login; it is never used to
# reset an existing admin. Prefer a strong value; do not commit a real one.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-initial-admin-password>

# Sign session cookies. MUST be a stable random value in production, otherwise
# sessions reset on every restart. Generate: python -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET_KEY=<random-hex-string>

# Set to 1/true only when HTTPS terminates in front of ArmyEye (marks the session
# cookie Secure). Leave unset for plain-HTTP local runs.
# SESSION_COOKIE_SECURE=false

# Custom-engine builder (admin only). OFF by default because it writes server-side
# Python that the node imports (effectively code execution). Enable deliberately.
ENABLE_ENGINE_BUILDER=false

# --- AI frames per second (per pipeline) --------------------------------------------------
# The camera keeps streaming at its own rate - this ONLY limits how often inference runs, so
# a 25 fps camera can be watched at 25 fps while AI samples 5 fps. Frames are always read, so
# nothing is buffered and the pipeline stays at the live edge.
#   0 or unset : infer every frame (highest load)
#   5          : a sensible surveillance default
# Per-pipeline override: detection_config.target_inference_fps
ARMYEYE_TARGET_INFERENCE_FPS=5

# When first importing existing JSON pipelines into the DB (Phase 3), assign them
# to this username (defaults to the seeded admin).
# ARMYEYE_IMPORT_OWNER_USERNAME=admin

# ---------------------------------------------------------------------------
# Managed artifact plane + configuration-secret encryption (PostgreSQL registry)
# ---------------------------------------------------------------------------
# Path (on the HOST) to the dedicated encryption key file mounted as a Docker secret.
# Generate once, keep mode 0600, back it up with the database - encrypted publisher /
# telemetry credentials cannot be recovered without it. NEVER reuse FLASK_SECRET_KEY.
#   python -c "from InferenceNode.config_secrets import generate_key_line as g; print(g('armyeye-config-2026-01'))" > secrets/armyeye_config_key
ARMYEYE_CONFIG_KEY_FILE=./secrets/armyeye_config_key
# FACE_DETECTOR's internal CA certificate (public material) so webhooks over HTTPS verify.
# Copy from the FACE deployment:  cp <FACE>/certs/internal-ca.crt ./secrets/face-internal-ca.crt
FACE_INTERNAL_CA_FILE=./secrets/face-internal-ca.crt

# --- Same host or separate hosts? --------------------------------------------------------
# Exactly ONE thing differs: how face-detector.internal resolves. WEBHOOK_BASE_URL, the CA,
# the bearer token and the certificate are identical either way - so keep the NAME above and
# switch only the lines below. See DOCS/MOVING_TO_A_SEPARATE_SERVER.md.
#
#   SAME HOST (default): resolution comes from the shared webhook_integration Docker network,
#   on which FACE's nginx carries the alias. Nothing extra to set.
#
#   SEPARATE HOSTS: append the overlay and give FACE nginx's real address. `extra_hosts` then
#   maps the same name to the real host, so TLS and auth keep working untouched:
#     COMPOSE_FILE=compose.yaml:compose.prod.yaml:compose.gpu.yaml:compose.remote-face.yaml
#     FACE_HOST_IP=10.0.0.42
#   (With real internal DNS, add an A record for face-detector.internal and skip both.)
# FACE_HOST_IP=

# Verify either mode the same way:  sh scripts/check-face-integration.sh
